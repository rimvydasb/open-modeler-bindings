{
  "name": "open-modeler-ts-core",
  "version": "0.1.0",
  "description": "Open Modeler TypeScript Core components",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "build": "tsc",
    "dev": "node --watch src/main.ts",
    "format": "npx prettier --write \"**/*.{ts,md}\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
